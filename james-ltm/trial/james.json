     "verses": "1:1–5",
     "objects": [
      "sealed papyrus letter with a red wax seal on a courier's stone shelf",
      "laughing bronze theatre mask on a tall wooden post",
      "gold ingot on a black touchstone slab",
      "flawless glazed blue amphora, tall and unchipped, on a plinth",
      "bronze lion-head fountain spouting water into a round basin"
     ]
    },
    {
     "room": 2,
     "name": "The Tower of the Winds",
     "verses": "1:6–10",
     "objects": [
      "barrel of churning seawater with a toy ship tossing in it",
      "bronze Triton weathervane spinning on an iron pole",
      "two-faced white marble herm, a head looking each way",
      "low three-legged wooden stool with a tiny gold garland on it",
      "stone urn of wilting red poppies"
     ]
    },
    {
     "room": 3,
     "name": "The Tholos",
     "verses": "1:11–15",
     "objects": [
      "scorched sundial ringed with dried yellow grass tufts",
      "gilded olive-leaf victor's crown on a red cushion",
      "polished bronze shield on a stand with a snapped arrow at its foot",
      "fowler's wicker trap baited with fresh figs",
      "egg-shaped clay pithos with a small black snake hatching from it"
     ]
    },
    {
     "room": 4,
     "name": "The Lamp Stoa",
     "verses": "1:16–20",
     "objects": [
      "conjurer's table with three cups and a hidden ball",
      "tall bronze seven-flame lampstand at noon that casts no shadow",
      "basket of the first barley sheaves tied with a red ribbon",
      "oversized white marble ear on a plinth",
      "boiling bronze cauldron over coals, steam pouring out"
     ]
    },
    {
     "room": 5,
     "name": "The Mirror Court",
     "verses": "1:21–25",
     "objects": [
      "stone washbasin of grey water with a soiled tunic over its rim",
      "mason's mallet and chisel on a half-carved limestone block",
      "polished bronze hand mirror on a stand",
      "wax writing tablet wiped smooth, stylus beside it",
      "inscribed stone stele with open unlocked iron shackles hanging from it"
     ]
    },
    {
     "room": 6,
     "name": "The Almshouse Portico",
     "verses": "1:26–27",
     "objects": [
      "leather horse bridle and bit hung on a wooden post",
      "basket of bread loaves with a small child's wooden toy horse beside it"
     ]
    }
   ]
