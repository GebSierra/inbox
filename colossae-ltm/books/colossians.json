      "district": "The Market",
      "ideasOverview": {"at": [0, 50], "dist": 80, "theta": 0},
      "ideas": [
        {
          "id": "supreme",
          "title": "Christ is supreme over everything",
          "verses": "1:15–20",
          "summary": "He is God's image, firstborn over creation; all things were made through him and hold together in him.",
          "anchor": { "label": "city gate", "where": {"at": [0, 78], "top": 11},
            "view": {"stand": [0, 66], "via": [[0, 88], [0, 72]]} },
          "example": "For example, picture a colossal crowned Christ standing astride the gate, one hand pressed on the arch so that every stone holds together."
        },
        {
          "id": "rescued",
          "title": "He rescued and reconciled us",
          "verses": "1:13–14, 21–22",
          "summary": "God pulled us out of darkness, forgave us, and made former enemies holy and blameless friends.",
          "anchor": { "label": "tall house on the left", "where": {"at": [-14, 52], "top": 11},
            "view": {"stand": [0, 46], "via": [[-3, 62], [-4, 56], [-1, 50]]} },
          "example": "For example, picture a rope ladder dropping from that roof as Christ hauls a crowd of grumpy strangers out of a dark pit and hugs each one."
        },
        {
          "id": "prays",
          "title": "Paul prays that they keep growing",
          "verses": "1:9–12",
          "summary": "Paul asks God to fill them with knowledge so they bear fruit, grow, and endure with joy.",
          "anchor": { "label": "tall house on the right", "where": {"at": [14, 52.5], "top": 11},
            "view": {"stand": [-5, 52], "via": []} },
          "example": "For example, picture Paul on that roof praying so hard that fruit trees sprout through the tiles and the house grows taller by the minute."
        }
      ],
