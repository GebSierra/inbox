      "ideasOverview": {"at": [32, 2], "dist": 55, "theta": 0},
      "ideas": [
        {
          "id": "newself",
          "title": "Put off the old, put on the new",
          "verses": "3:5–10",
          "summary": "Take off anger and lies like dirty clothes; put on the new self, renewed in God's image.",
          "anchor": { "label": "front door", "where": {"at": [32, 12], "top": 3.2},
            "view": {"stand": [32, 31], "via": [[0, 19], [22, 19], [30, 24]]} },
          "example": "For example, picture a pile of stinking old clothes dumped on the doorstep, each labelled with a sin, and a glowing new robe hanging in the open doorway."
        },
        {
          "id": "love",
          "title": "Love binds everything together",
          "verses": "3:12–14",
          "summary": "Wear compassion, kindness, humility and patience, and above all love, which binds everything in perfect harmony.",
          "anchor": { "label": "loom room", "where": {"at": [24, 9], "top": 3},
            "view": {"stand": [25, 0.5], "via": [[32, 18], [32, 8], [29, 6.5], [28, 3]]} },
          "example": "For example, picture a giant golden thread of love running from the loom across the whole house, weaving every room and every person into one blanket."
        },
        {
          "id": "rules",
          "title": "Christ rules all of daily life",
          "verses": "3:17–25",
          "summary": "Whatever you do, at home or at work, do it heartily in Jesus' name.",
          "anchor": { "label": "atrium pool", "where": {"at": [32, 3], "top": 3},
            "view": {"stand": [32, 9.5], "via": [[28, 3], [29, 6.5]]} },
          "example": "For example, picture Christ himself sitting on the edge of the pool, his name floating on the water over your tools, your lunch and your sandals."
        }
      ],
