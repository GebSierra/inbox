    {
      "chapter": 2,
      "verses": 23,
      "district": "The Temple Courtyard",
      "layout": { "dais": "none" },
      "ideasOverview": {"at": [0, 6], "dist": 60, "theta": 0},
      "ideas": [
        {
          "id": "complete",
          "title": "We are complete in Christ",
          "verses": "2:9–10",
          "summary": "All of God's fullness lives in Christ in bodily form, and in him you have been filled.",
          "anchor": { "label": "temple entrance", "where": {"at": [0, 0.6], "top": 4.2},
            "view": {"stand": [0, 14.5], "via": [[0, 44], [0, 30], [0, 20]]} },
          "example": "For example, picture the temple doorway as a giant jar with Christ standing in it, so full of God that golden light spills over the steps and floods the whole courtyard."
        },
        {
          "id": "captive",
          "title": "Don't be taken captive by human philosophy",
          "verses": "2:4, 8",
          "summary": "Don't let clever arguments and empty human tradition carry you off. Stay rooted in Christ.",
          "anchor": { "label": "philosopher statue by the pigeon cages", "where": {"at": [-10, 7], "top": 5.4},
            "view": {"stand": [2, 15], "via": []} },
          "example": "For example, picture the marble philosopher stepping off his pedestal and tucking you under his arm like a rolled-up rug, while the pigeon cages rattle and flap behind him."
        },
        {
          "id": "shadows",
          "title": "Rules and rituals are only shadows",
          "verses": "2:16–17, 20–23",
          "summary": "Food laws and festivals are shadows of what was coming; the substance belongs to Christ.",
          "anchor": { "label": "the temple itself", "where": {"at": [0, -4], "top": 12.5},
            "view": {"stand": [0, 16], "via": []} },
          "example": "For example, picture the whole temple casting a giant shadow shaped like a feast across the courtyard, while Christ, the solid real person, steps out into the sunshine and the shadow fades."
        }
      ],
