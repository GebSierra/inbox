      "ideas": [
        {
          "id": "pray",
          "title": "Pray, and watch for open doors",
          "verses": "4:2–4",
          "summary": "Keep praying with thankful alertness, and ask God to open a door for the message.",
          "anchor": { "label": "stone arch bridge", "where": {"at": [63.8, 2], "top": 4},
            "view": {"stand": [50, 2.5], "via": [[41, 4], [46, 4]]} },
          "example": "For example, picture each bridge arch as a doorway swinging open as you pray, with the gospel pouring through like a river of light."
        },
        {
          "id": "grace",
          "title": "Speak with grace",
          "verses": "4:5–6",
          "summary": "Be wise with outsiders, and let your words be gracious and seasoned with salt.",
          "anchor": { "label": "the donkey", "where": {"at": [75.25, 10.5], "top": 3.6},
            "view": {"stand": [83, 7], "via": [[50, 0], [56, 2], [80, 2], [82, 4]]} },
          "example": "For example, picture the donkey carrying a huge salt shaker on its back and sprinkling gentle words on everyone it passes, so that every bray comes out as a kind reply."
        },
        {
          "id": "team",
          "title": "Greetings from the team",
          "verses": "4:7–18",
          "summary": "Paul sends news and greetings from friends who serve with him. Every person on the team matters.",
          "anchor": { "label": "the waystation", "where": {"at": [105.8, -9], "top": 7},
            "view": {"stand": [93.8, 3], "via": [[87.8, 2]]} },
          "example": "For example, picture the waystation porch crammed with Paul's whole team waving, hugging and shouting greetings at you."
        }
      ],
